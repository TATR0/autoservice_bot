# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAABBBCCC...
BOT_USERNAME=your_bot_username        # без @, нужен для ссылок t.me/<bot>?start=...

# ── Публичный адрес сервиса ───────────────────────────────────────────────────
# Домен, на который у вас настроена A-запись в сторону VPS. Caddy выпустит на
# него сертификат сам. Только имя: без https:// и без слэша.
DOMAIN=bot.example.com
# Настоящий адрес: на него придёт письмо, если с сертификатом что-то не так.
# Почту на example.com Let's Encrypt отклоняет, и сертификата не будет
ACME_EMAIL=owner@example.com

# Порт, на котором бот слушает HTTPS. 443 — обычный случай. Меняйте, если
# 443 на сервере уже занят (VPN, чужой веб-сервер): Telegram доставляет
# вебхук только на 443, 80, 88 и 8443, других вариантов нет. Порт 80 нужен
# в любом случае — по нему проходит проверка домена для сертификата.
HTTPS_PORT=443

# Тот же домен, но целиком. Отсюда собирается URL вебхука и адрес формы
# записи (BASE_URL/app/). Без слэша в конце. Порт, если он не 443, пишется
# и здесь: https://bot.example.com:8443
BASE_URL=https://bot.example.com

# Секрет вебхука: и часть URL, и заголовок X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=замените-на-случайную-строку

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# База поднимается рядом с ботом, в контейнере db, и наружу не публикуется.
# Пароль придумывать не нужно: ./scripts/init_env.sh сгенерирует его и
# подставит в обе строки ниже. Менять — только вместе, они должны совпадать.
POSTGRES_DB=autoservice
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=замените-на-случайную-строку

# Хост db — это имя сервиса в docker-compose.yml, оно резолвится внутри сети
# compose. sslmode=disable здесь уместен: соединение не выходит за пределы
# машины, а без него драйвер потребует TLS, которого у соседнего контейнера нет
DATABASE_URL=postgresql://autoservice:замените-на-случайную-строку@db:5432/autoservice?sslmode=disable

# Порт базы на самой машине, для pgAdmin и psql по SSH-туннелю. Наружу не
# выставляется в любом случае. Менять, только если 5432 на сервере уже занят
DB_LOCAL_PORT=5432

DB_POOL_MIN=1
DB_POOL_MAX=5

# ── База для тестов ───────────────────────────────────────────────────────────
# Сюита создаёт и удаляет записи по-настоящему, поэтому ей нужна своя база.
# Пусто → тесты пойдут в DATABASE_URL, то есть в боевые данные, и предупредят
# об этом на каждом прогоне. Вторая база в том же контейнере:
#   docker compose exec db createdb -U autoservice autoservice_test
#   docker compose exec -T db psql -U autoservice -d autoservice_test < schema.sql
# и сюда строку ...@db:5432/autoservice_test?sslmode=disable — она работает
# изнутри compose. На машине разработчика — свой PostgreSQL на localhost.
TEST_DATABASE_URL=

# ── Резервные копии ───────────────────────────────────────────────────────────
# Снимок базы делает сервис backup из docker-compose.yml, сам, без установки.
BACKUP_INTERVAL_HOURS=24   # как часто снимать
BACKUP_KEEP=14             # сколько снимков хранить, остальные удаляются

# Куда увозить копии с машины. Без этого снимки лежат на том же диске, что и
# база, и пропавший сервер унесёт их вместе с ней. Значение — адрес rclone:
#   vault:                         зашифрованное хранилище поверх любого другого
#   yadisk:autoservice-backups     Яндекс.Диск по WebDAV
#   s3:bucket/autoservice          любое S3-хранилище
# В снимке лежат телефоны и госномера клиентов, поэтому возить стоит через
# crypt: тогда в облаке окажутся файлы, которые без пароля не прочесть.
# Хранилище настраивается один раз, и только это — руками, порядок в README:
#   docker run --rm -it -v "$PWD/secrets:/config/rclone" rclone/rclone:1 config
# Пусто — вывоза нет, и выкат об этом предупредит.
BACKUP_REMOTE=

# Сколько часов хранилищу позволено молчать, прежде чем бот напишет владельцу.
# Облаку хватает суток: оно доступно всегда, и молчание дольше — уже беда.
# Домашней машине ставьте 48: ночью она выключена, и это не поломка
BACKUP_OFFSITE_GRACE_HOURS=24

# ── Присмотр за ботом ─────────────────────────────────────────────────────────
# Сервис watchdog из docker-compose.yml раз в WATCHDOG_TICK_SECONDS проверяет
# бота, базу, вебхук, место на диске и срок сертификата и пишет владельцу
# (BOT_OWNER_IDS), когда что-то сломалось. Настройки не требует.
WATCHDOG_TICK_SECONDS=300
WATCHDOG_MAX_PENDING=50          # апдейтов в очереди Telegram, выше — затор
WATCHDOG_DISK_MIN_FREE_PCT=10    # меньше свободного места — база перестанет писать
WATCHDOG_CERT_MIN_DAYS=7         # за сколько дней до конца сертификата звать

# Внешняя «кнопка живости»: сторож нажимает её каждый удачный круг. Пропала
# машина целиком — нажимать некому, и напишет уже сторонний сервис; изнутри
# такое заметить нельзя в принципе. Бесплатно: https://healthchecks.io —
# завести проверку с периодом 5 минут и вставить сюда её ping-адрес.
# Пусто — этого слоя нет, и выкат об этом предупредит
WATCHDOG_PING_URL=

# ── За обратным прокси ────────────────────────────────────────────────────────
# На VPS перед ботом стоит Caddy, поэтому true: адрес клиента для лимитов
# частоты берётся из X-Forwarded-For. Ставьте false, только если бот смотрит
# в интернет напрямую — иначе заголовок подставит сам клиент, и лимит
# перестанет что-либо значить.
TRUST_PROXY=true

# ── FSM (опционально) ─────────────────────────────────────────────────────────
# Пусто → состояния хранятся в PostgreSQL (таблица fsm_storage), это рабочий
# вариант по умолчанию. Для Redis: раскомментируйте redis в requirements.txt.
REDIS_URL=

# ── Misc ──────────────────────────────────────────────────────────────────────
# ── Персональные данные клиентов ──────────────────────────────────────────────
# Через сколько дней после обращения стереть из заявки имя, телефон, машину и
# комментарий. Сама заявка остаётся: сервису она нужна как история загрузки, но
# личного в ней уже нет. Активные заявки не трогаются — по ним человека ждут.
# Пусто или 0 — данные хранятся вечно, и страница /privacy честно про это
# напишет: обещать удаление, которого не происходит, нельзя. Год — разумный
# срок: постоянный клиент за это время обратится снова, чужому в базе не место
PII_RETENTION_DAYS=365

MASTER_CHAT_ID=0                 # чат для «потерянных» заявок (0 — отключено)
DEFAULT_TIMEZONE=Europe/Moscow   # часовой пояс новых сервисов
BOT_OWNER_IDS=                   # Telegram id владельцев бота через запятую, для /extend и /refund
TICK_SECRET=                     # секрет POST /internal/subscriptions/tick; пусто — закрыт
SUPPORT_CONTACT=                 # куда управляющему писать за продлением подписки
TRIAL_DAYS=5                     # пробный период нового сервиса, дней

# ── Подписка ──────────────────────────────────────────────────────────────────
# Выключено, пока платить нечем: срок считается, но никого не отключает и
# писем не шлёт. Ставится в true в день, когда появится приём денег
SUBSCRIPTION_ENFORCED=false
REMINDER_TICK_SECONDS=3600       # как часто бот сам будит рассылку напоминаний

# Чем платят за подписку:
#   stars    — счёт Telegram. Деньги приходят сами, дни начисляются без вас,
#              но магазины Apple и Google забирают около трети суммы.
#   yoomoney — ссылка на перевод. Комиссия в разы меньше, дни начисляются
#              сами по уведомлению ЮMoney — но только если заполнен
#              YOOMONEY_NOTIFY_SECRET ниже. Без него платёж придётся
#              проводить руками: /extend sub:<idservice>:<дней>.
# Можно оба через запятую: yoomoney,stars — тогда после выбора срока бот
# спросит, чем платить. Карта российского банка есть не у всех, а звёзды
# покупают из любой страны
PAYMENT_METHOD=yoomoney,stars
YOOMONEY_WALLET=               # номер кошелька, нужен только для yoomoney

# Секрет HTTP-уведомлений ЮMoney. Берётся здесь:
#   https://yoomoney.ru/transfer/myservices/http-notification
# Туда же вписывается адрес приёмника: BASE_URL + /yoomoney/notify
# Пусто — уведомления не принимаются, и дни начисляются командой /extend руками
YOOMONEY_NOTIFY_SECRET=

# Кто берёт деньги за подписку — сторона оферты. Принять договор можно только
# у кого-то: без этих трёх строк страница /offer не открывается, и ссылки на
# оферту под тарифами не будет. Заполняются, когда появится статус
# самозанятого или ИП:
#   OFFER_PROVIDER=Самозанятый Иванов Иван Иванович
#   OFFER_INN=123456789012
#   OFFER_CONTACT=owner@example.com   # куда писать претензии и просить возврат
OFFER_PROVIDER=
OFFER_INN=
OFFER_CONTACT=

# Цены тарифов. Задаются только в рублях: цена в звёздах считается из них,
# чтобы после комиссии магазинов на руки приходило столько же
PRICE_1M=590
PRICE_3M=1490
PRICE_12M=4490

# Сколько рублей стоит одна звезда тому, кто её покупает, и сколько магазины
# Apple и Google забирают со звёздной оплаты. 590 ₽ при этих значениях
# превращаются в 767 ⭐ — столько же денег после комиссии
STAR_RATE_RUB=1
STARS_FEE_PCT=30
LOG_LEVEL=INFO

# ── Лимиты и антиспам ─────────────────────────────────────────────────────────
FREE_PLAN_SERVICE_LIMIT=1        # сервисов на одного управляющего
REQUEST_COOLDOWN_SECONDS=60      # не чаще одной заявки в N секунд
MAX_ACTIVE_REQUESTS=3            # активных заявок клиента в одном сервисе
INIT_DATA_MAX_AGE=600           # срок годности подписи Telegram WebApp, сек
INVITE_TTL_DAYS=7                # срок жизни инвайт-ссылки администратора
