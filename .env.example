# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAABBBCCC...
BOT_USERNAME=your_bot_username        # без @, нужен для ссылок t.me/<bot>?start=...

# ── Публичный адрес сервиса ───────────────────────────────────────────────────
# Render выдаёт его после первого деплоя. Отсюда собирается URL вебхука
# и URL формы записи (BASE_URL/app/). Без слэша в конце.
BASE_URL=https://your-service.onrender.com

# Секрет вебхука: и часть URL, и заголовок X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=замените-на-случайную-строку

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# ВАЖНО: строка Session Pooler'а, а НЕ db.<project>.supabase.co —
# прямой хост отдаёт только IPv6 и с Render не резолвится.
# Supabase → Project Settings → Database → Connection pooling → Session mode
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_POOL_MIN=1
DB_POOL_MAX=5

# ── База для тестов ───────────────────────────────────────────────────────────
# Сюита создаёт и удаляет записи по-настоящему, поэтому ей нужна своя база.
# Пусто → тесты пойдут в DATABASE_URL, то есть в боевые данные, и предупредят
# об этом на каждом прогоне. Заведите отдельный проект Supabase (или локальный
# PostgreSQL) и примените к нему schema.sql.
TEST_DATABASE_URL=

# ── Резервные копии ───────────────────────────────────────────────────────────
# Снимок базы делает сервис backup из docker-compose.yml, сам, без установки.
BACKUP_INTERVAL_HOURS=24   # как часто снимать
BACKUP_KEEP=14             # сколько снимков хранить, остальные удаляются

# ── FSM (опционально) ─────────────────────────────────────────────────────────
# Пусто → состояния хранятся в PostgreSQL (таблица fsm_storage), это рабочий
# вариант по умолчанию. Для Redis: раскомментируйте redis в requirements.txt.
REDIS_URL=

# ── Misc ──────────────────────────────────────────────────────────────────────
MASTER_CHAT_ID=0                 # чат для «потерянных» заявок (0 — отключено)
DEFAULT_TIMEZONE=Europe/Moscow   # часовой пояс новых сервисов
BOT_OWNER_IDS=                   # Telegram id владельцев бота через запятую, для /extend и /refund
TICK_SECRET=                     # секрет POST /internal/subscriptions/tick; пусто — закрыт
SUPPORT_CONTACT=                 # куда управляющему писать за продлением подписки
TRIAL_DAYS=5                     # пробный период нового сервиса, дней

# ── Подписка ──────────────────────────────────────────────────────────────────
# Выключено, пока платить нечем: срок считается, но никого не отключает и
# писем не шлёт. Ставится в true в день, когда появится приём денег
SUBSCRIPTION_ENFORCED=false
REMINDER_TICK_SECONDS=3600       # как часто бот сам будит рассылку напоминаний
STARS_PRICE_1M=150               # цена месяца в звёздах Telegram
STARS_PRICE_3M=400               # три месяца
STARS_PRICE_12M=1350             # год
LOG_LEVEL=INFO

# ── Лимиты и антиспам ─────────────────────────────────────────────────────────
FREE_PLAN_SERVICE_LIMIT=1        # сервисов на одного управляющего
REQUEST_COOLDOWN_SECONDS=60      # не чаще одной заявки в N секунд
MAX_ACTIVE_REQUESTS=3            # активных заявок клиента в одном сервисе
INIT_DATA_MAX_AGE=600           # срок годности подписи Telegram WebApp, сек
INVITE_TTL_DAYS=7                # срок жизни инвайт-ссылки администратора
