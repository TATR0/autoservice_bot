# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAABBBCCC...
BOT_USERNAME=your_bot_username        # без @, нужен для ссылок t.me/<bot>?start=...

# ── Публичный адрес сервиса ───────────────────────────────────────────────────
# Домен, на который у вас настроена A-запись в сторону VPS. Caddy выпустит на
# него сертификат сам. Только имя: без https:// и без слэша.
DOMAIN=bot.example.com
ACME_EMAIL=owner@example.com   # письмо, если с сертификатом что-то не так

# Порт, на котором бот слушает HTTPS. 443 — обычный случай. Меняйте, если
# 443 на сервере уже занят (VPN, чужой веб-сервер): Telegram доставляет
# вебхук только на 443, 80, 88 и 8443, других вариантов нет. Порт 80 нужен
# в любом случае — по нему проходит проверка домена для сертификата.
HTTPS_PORT=443

# Тот же домен, но целиком. Отсюда собирается URL вебхука и адрес формы
# записи (BASE_URL/app/). Без слэша в конце. Порт, если он не 443, пишется
# и здесь: https://bot.example.com:8443
BASE_URL=https://bot.example.com

# Секрет вебхука: и часть URL, и заголовок X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=замените-на-случайную-строку

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# База поднимается рядом с ботом, в контейнере db, и наружу не публикуется.
# Пароль придумывать не нужно: ./scripts/init_env.sh сгенерирует его и
# подставит в обе строки ниже. Менять — только вместе, они должны совпадать.
POSTGRES_DB=autoservice
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=замените-на-случайную-строку

# Хост db — это имя сервиса в docker-compose.yml, оно резолвится внутри сети
# compose. sslmode=disable здесь уместен: соединение не выходит за пределы
# машины, а без него драйвер потребует TLS, которого у соседнего контейнера нет
DATABASE_URL=postgresql://autoservice:замените-на-случайную-строку@db:5432/autoservice?sslmode=disable

DB_POOL_MIN=1
DB_POOL_MAX=5

# ── База для тестов ───────────────────────────────────────────────────────────
# Сюита создаёт и удаляет записи по-настоящему, поэтому ей нужна своя база.
# Пусто → тесты пойдут в DATABASE_URL, то есть в боевые данные, и предупредят
# об этом на каждом прогоне. Вторая база в том же контейнере:
#   docker compose exec db createdb -U autoservice autoservice_test
#   docker compose exec -T db psql -U autoservice -d autoservice_test < schema.sql
# и сюда строку ...@db:5432/autoservice_test?sslmode=disable — она работает
# изнутри compose. На машине разработчика — свой PostgreSQL на localhost.
TEST_DATABASE_URL=

# ── Резервные копии ───────────────────────────────────────────────────────────
# Снимок базы делает сервис backup из docker-compose.yml, сам, без установки.
BACKUP_INTERVAL_HOURS=24   # как часто снимать
BACKUP_KEEP=14             # сколько снимков хранить, остальные удаляются

# ── За обратным прокси ────────────────────────────────────────────────────────
# На VPS перед ботом стоит Caddy, поэтому true: адрес клиента для лимитов
# частоты берётся из X-Forwarded-For. Ставьте false, только если бот смотрит
# в интернет напрямую — иначе заголовок подставит сам клиент, и лимит
# перестанет что-либо значить.
TRUST_PROXY=true

# ── FSM (опционально) ─────────────────────────────────────────────────────────
# Пусто → состояния хранятся в PostgreSQL (таблица fsm_storage), это рабочий
# вариант по умолчанию. Для Redis: раскомментируйте redis в requirements.txt.
REDIS_URL=

# ── Misc ──────────────────────────────────────────────────────────────────────
MASTER_CHAT_ID=0                 # чат для «потерянных» заявок (0 — отключено)
DEFAULT_TIMEZONE=Europe/Moscow   # часовой пояс новых сервисов
BOT_OWNER_IDS=                   # Telegram id владельцев бота через запятую, для /extend и /refund
TICK_SECRET=                     # секрет POST /internal/subscriptions/tick; пусто — закрыт
SUPPORT_CONTACT=                 # куда управляющему писать за продлением подписки
TRIAL_DAYS=5                     # пробный период нового сервиса, дней

# ── Подписка ──────────────────────────────────────────────────────────────────
# Выключено, пока платить нечем: срок считается, но никого не отключает и
# писем не шлёт. Ставится в true в день, когда появится приём денег
SUBSCRIPTION_ENFORCED=false
REMINDER_TICK_SECONDS=3600       # как часто бот сам будит рассылку напоминаний
STARS_PRICE_1M=150               # цена месяца в звёздах Telegram
STARS_PRICE_3M=400               # три месяца
STARS_PRICE_12M=1350             # год
LOG_LEVEL=INFO

# ── Лимиты и антиспам ─────────────────────────────────────────────────────────
FREE_PLAN_SERVICE_LIMIT=1        # сервисов на одного управляющего
REQUEST_COOLDOWN_SECONDS=60      # не чаще одной заявки в N секунд
MAX_ACTIVE_REQUESTS=3            # активных заявок клиента в одном сервисе
INIT_DATA_MAX_AGE=600           # срок годности подписи Telegram WebApp, сек
INVITE_TTL_DAYS=7                # срок жизни инвайт-ссылки администратора
